# =============================================================================
# BSPP Runtime Configuration
# =============================================================================
# Copy to .env and fill in values. .env is gitignored.
#
# Available image tags: postprocessing, preprocessing, folding-<image>
# (the former current/latest/baked-toolkit tags are consolidated into postprocessing).

# --- Toolkit source for the generic (postprocessing) image build ---
# The public build defaults TOOLKIT_REPO to the public upstream toolkit. The
# internal fork is selected only by the internal build path
# (containers/nvidia/build-internal.sh + config.toml), never here.

# --- Container Selection ---
IMAGE_TAG=postprocessing
# BASE_DIR=/path/to/bspp
# CONTAINER_DIR=${BASE_DIR}/containers
# CONTAINER_IMAGE=${CONTAINER_DIR}/bspp-orchestration-postprocessing.sqsh

# --- Host source paths for editable mounts ---
# TOOLKIT_DIR=/path/to/bspp/AFDB-Integration-Kit
# ORCH_DIR=/path/to/bspp-orchestration

# --- Pipeline Parameters ---
# MODEL_IDS_FILE=
# INPUT_DIR=
# OUTPUT_DIR=
# MANIFEST_CSV=
# UNIPROT_DB=
WORKERS=24
CLASH_DEVICE=cuda

# --- Google Cloud ---
# GOOGLE_APPLICATION_CREDENTIALS=

# --- Swiftstack ---
# SWIFTSTACK_ACCESS_KEY=
# SWIFTSTACK_SECRET_KEY=
